# Node 24, pnpm 10: pnpm install --frozen-lockfile; pnpm build
# Copy to .env, fill secrets, then export: set -a; . ./.env; set +a
# This file is not automatically loaded by Node.
# Build/start only the application being changed:
# pnpm build:bot; pnpm bot                  # Telegram + Mini App, one node
# pnpm build:worker; pnpm worker            # Parsers, a separate node
# pnpm build:vin; pnpm vin                  # Independent private VIN API
# pnpm worker sync --pages 3; pnpm worker sources (offline, no backend/token/proxy)
# pnpm autodom --help                      # Storage administration, not service startup
# Local full stack: docker compose -p autodom-dev up -d --build
# Local parser-only update: docker compose -p autodom-dev up -d --no-deps --build worker
# Use separate development databases and bot credentials, never the production token.
# Never start a second real Telegram poller while testing or migrating.
AUTODOM_BOT_TOKEN=
# Unset token may be read with: pass show autodom/telegram/bot-token

# Mini App belongs to the SAME process/container/release as the Telegram bot.
# Filters and one-car browsing stay in chat. Notifications send native photo albums
# (up to 10 photos) plus complete Rich HTML descriptions; unsupported API versions
# use ordinary Telegram HTML without truncation.
# The Mini App only opens a selected car's supplementary details and supplied VIN.
# Optional VIN preflight uses the separate private API configured below; no full report is bought.
# Set this URL to enable HTTP in pnpm bot; blank keeps the chat-only bot unchanged.
# Example: https://cars.example.org/miniapp/ (no query/fragment).
AUTODOM_MINI_APP_URL=
AUTODOM_MINI_APP_PORT=8080
AUTODOM_MINI_APP_HOST=127.0.0.1
# Docker's dedicated HTTP listener, loopback-only by default.
# For Cloudflare Tunnel on the LAN, use the server IP:port, e.g. 192.168.0.2:18080.
# The tunnel service is HTTP to this endpoint; AUTODOM_MINI_APP_URL remains HTTPS.
AUTODOM_MINI_APP_PUBLISH=127.0.0.1:18080
# Coolify: create THREE Git-based Compose application resources in the Autodom project:
# bot + Mini App -> /compose.bot.yaml, parser -> /compose.worker.yaml, VIN -> /compose.vin.yaml.
# Do NOT deploy root compose.yaml as one production application: it is for local dev.
# Bot/parser use existing Autodom backends. VIN needs no PostgreSQL, Redis or Telegram token.
# AUTODOM_NETWORK must be the EXISTING stack's private network, not a new app's UUID.
# The bot also joins AUTODOM_PROXY_NETWORK for Coolify's HTTPS proxy.
# Route Mini App HTTPS to bot:8080; worker exposes only private metrics, no public domain.
# Cloudflare may instead target the dedicated AUTODOM_MINI_APP_PUBLISH listener.
# /health is HTTP liveness; /ready checks the Mini App's actual DB pool.
# pnpm bot health / pnpm worker health probe their own process's metrics listener.
# Separate processes on one host must set different AUTODOM_METRICS_PORT values.
# Coolify image-name/publish variables must be enabled at build time AND runtime.
# Backend credentials, Telegram tokens and scraper proxies are runtime-only.
AUTODOM_BOT_IMAGE=autodom-bot:local
AUTODOM_WORKER_IMAGE=autodom-worker:local
AUTODOM_VIN_IMAGE=autodom-vin:local
AUTODOM_NETWORK=autodom
AUTODOM_PROXY_NETWORK=coolify
# Production files require pre-existing volumes. Set their exact names before cutover.
# Their fallback names use COMPOSE_PROJECT_NAME; do not assume new resource UUIDs match old ones.
# Root compose.yaml instead manages its own project-scoped local development volumes.
AUTODOM_POSTGRES_VOLUME=
AUTODOM_REDIS_VOLUME=
AUTODOM_SNAPSHOTS_VOLUME=
AUTODOM_CRAWLER_VOLUME=
# IMPORTANT: set each Coolify application's Watch Paths before enabling Auto Deploy.
# Each Watch Paths entry is a SEPARATE LINE, not a comma-separated list.
# Bot-only paths:
# apps/bot/**
# compose.bot.yaml
# tsup.config.ts
# Worker-only paths:
# apps/worker/**
# packages/sources/**
# compose.worker.yaml
# Add these SHARED paths to BOTH resources:
# packages/core/**
# packages/storage/**
# apps/runtime/**
# package.json
# pnpm-lock.yaml
# pnpm-workspace.yaml
# patches/**
# tsconfig.json
# .npmrc
# .dockerignore
# Shared schema/contracts/dependencies require a coordinated compatible release.
# Never use a repository-wide deploy webhook/tag that restarts both resources.
# If the configured Git provider cannot filter changed paths, disable Auto Deploy
# and trigger only the intended resource UUID from CI or its Deploy button.
# First production cutover when the old Compose resource ALSO owns PostgreSQL/Redis:
# 1. Take and verify a DB backup; record the old resource, credentials and volume names.
# 2. Create native PostgreSQL and Redis resources INSIDE the Autodom project, private-only.
#    Keep the EXISTING private Docker network; stage and verify database restoration.
# 3. Prepare independent bot/parser resources with native backend URLs. Explicitly reuse
#    the existing snapshots/crawler-data volumes; keep the singleton bot stopped.
# 4. Stop the old worker and bot, take the final DB dump, restore to the staged database,
#    and compare all tables/sequences. Cold-copy Redis persistence into its new volume.
#    Retain old backend volumes and a verified off-host backup for rollback.
# 5. Start the native backends and independent apps; verify data and both role health checks.
#    Verify public HTTPS before completing Mini App publication; keep Auto Deploy disabled.
# If backends already have dedicated resources, retain them instead of creating replacements.
# All production volumes are external: missing names must fail, not silently create empty data.
# Never use compose down -v or remove the old snapshots/crawler-data volumes.
# Subsequent parser releases deploy/rollback only the worker resource.
# PostgreSQL remains a shared dependency; this split is not database HA.
# The bot configures the commands menu; Mini App buttons appear only on car details.
# In @BotFather keep the same HTTPS Mini App domain and origin protection enabled.
# initData is verified on the server and expires after one hour; reopen to renew.
# Storage consent uses a current single-use chat button; reopening /start replaces it.

# Private VIN API: server-to-server only, never put its token in Mini App assets/initData.
# Bot receives only these two values; blank BOTH disables checks with an explicit message.
# Production URL on AUTODOM_NETWORK: http://autodom-vin-api:8080
AUTODOM_VIN_API_URL=
AUTODOM_VIN_API_TOKEN=
# Generate 32+ random non-space ASCII characters; store privately, same value on bot/API.
# POST /v1/vin/check with Authorization: Bearer <token>, Content-Type: application/json,
# body {"vin":"KMFXKN7BPXU258800"}. No query parameters; body <=1024 bytes.
# 200: vin, checked_at (Unix seconds), carhistory/car365 observations.
# Optional nhtsa_vpic/autodev observations appear only when the respective provider is enabled.
# Per-source status: available, not_found (NOT a clean history), unavailable, disabled.
# car365.data: vin, model, last_mileage_km, export_date, first_registration_date, total_loss.
# Unknown fields stay null; export_date is NOT the date of the odometer reading.
# nhtsa_vpic.data: vin, make, model, model_year, body_class, fuel_type, plant_country.
# NHTSA is US-market manufacturer decoding, NOT accident/mileage/title/ownership history.
# plant_country is assembly country, not the vehicle's registration/history region.
# autodev.data: vin, make, model, model_year, trim, body_class, engine, drive,
# transmission, origin_country, ambiguous. Missing characteristics are null.
# Global coverage varies by vehicle; ambiguous=true is not a confirmed unique specification.
# origin_country does not establish where the vehicle was registered or used.
# 401: authentication; 400/413/415: invalid input; 429: busy, respect Retry-After.
# GET/HEAD /health returns liveness only; provider failures do not make it unhealthy.
# Mini App uses its existing tma authentication at POST /miniapp/api/vin, not this token.
# /vin <VIN> in a private chat requires no buyer profile and does not change drafts.
# VIN SERVICE ONLY: explicit providers carhistory,car365,nhtsa_vpic,autodev.
# Korean providers require both SMARTPROXY tiers; no direct Korean fallback.
# nhtsa_vpic uses the free public NHTSA HTTPS API directly; it needs no key or proxy.
# autodev uses direct https://api.auto.dev/vin/{vin} with Authorization Bearer, never a query key.
# Free account: 1,000 calls/month, capped at the provider. No retries/upgrades/paid products.
# CarHistory checks report availability; Car365 checks the public export record.
# No paid report, account login, Browserless, GPU or VIN persistence.
AUTODOM_VIN_PROVIDERS=
# Required only when autodev is enabled. Server-only secret: pass/Coolify, never bot/browser/git.
AUTODOM_AUTODEV_API_KEY=
AUTODOM_VIN_API_HOST=127.0.0.1
# Local host port avoids Mini App's 8080; compose.vin.yaml fixes internal port 8080.
AUTODOM_VIN_API_PORT=8081
AUTODOM_VIN_API_MAX_IN_FLIGHT=10
# Deploy VIN independently with /compose.vin.yaml; no domain or published host port.
# For additive providers: deploy compatible bot first, then VIN code, then enable provider.
# Do not change parser/backends. Keep the provider disabled until both versions support it.
# Keep VIN auto-deploy disabled unless watch paths explicitly include apps/vin/**,
# packages/core/**, packages/sources/**, compose.vin.yaml and shared build manifests.
# Roll back only the affected resource; never start a second Telegram poller.

# Host development/admin URLs. Use only Autodom's own databases.
AUTODOM_DATABASE_URL=postgresql://autodom:replace-with-url-safe-secret@127.0.0.1:5432/autodom
AUTODOM_REDIS_URL=redis://:replace-with-url-safe-secret@127.0.0.1:6379/0
# Compose constructs its private-network URLs using these independent secrets.
# Generate distinct URL-safe values, for example with: openssl rand -hex 24
AUTODOM_POSTGRES_PASSWORD=
AUTODOM_REDIS_PASSWORD=
AUTODOM_DATA_DIR=.local
AUTODOM_BACKUP_DIR=.local/backups
AUTODOM_METRICS_PORT=9901
AUTODOM_LOG_LEVEL=info
AUTODOM_REFRESH_SECONDS=300
AUTODOM_REFRESH_PAGES=3
AUTODOM_CRAWL_DELAY=2
AUTODOM_FULL_REFRESH_SECONDS=86400
AUTODOM_MONITOR_SECONDS=30

# Foreign adapters default OFF; production activation requires an explicit operator decision.
# Gating applies to collection, search and notifications, including imported rows.
AUTODOM_APPROVED_SOURCES=mashina.kg
# Explicit opt-in can add encar.com, truecar.com and/or bid.cars; provider restrictions still apply.
# The registry separates adapter readiness, provider authorization and this operator opt-in.
# A working parser/robots/public page is not a data license. Record written reuse permission.
# Set the SAME source list on bot and worker: collection and user-facing access are gated separately.
# Encar: Korean domestic brands; export availability is NOT confirmed.
# TrueCar: Toyota Camry / New York search, 75-mile request radius, not nationwide coverage.
# Results can include remote dealers offering delivery; each car retains its dealer's city.
# The city route fixes geography across proxy IPs. Validate any changed URL/scope.
# NOT_PRICED cars retain an unknown price; the site's 0.00 placeholder never matches a budget.
# Missing trim/transmission stay unknown and cannot satisfy those specific filters.
AUTODOM_TRUECAR_SEARCH_URL=https://www.truecar.com/used-cars-for-sale/listings/toyota/camry/location-new-york-ny/
# Bid.Cars: public English Copart/IAAI catalog/details, evidenced US yards only.
# Optional /en/automobile/<make>/<model>/page/1; no app or search endpoints.
# Bid.Cars alone uses a Firefox TLS/HTTP2 client through the configured proxies, not an external solver.
# Origin 429 cooldowns and the two-second request floor remain in force.
AUTODOM_BIDCARS_CATALOG_URL=https://bid.cars/en/automobile/page/1
# Only active Buy Now offers with an evidenced future UTC deadline match budgets.
# Current/final bids and estimates remain separate; archived lots never match.
# Odometer values explicitly marked unknown remain unknown, including numeric placeholders.
# Run and Drive is an auction claim, not a condition guarantee. The EU calculator
# does not calculate Kyrgyz delivery, duties, paperwork, repair or landed costs.
# Terms: https://fem.encar.com/policy/terms, https://www.truecar.com/terms/,
# https://bid.cars/en/terms and https://bid.cars/terms_en.pdf

# Both independent Autodom proxy tiers are mandatory; no direct fallback.
# NBKR XML also uses these proxies. Never commit credentials.
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
SMARTPROXY_DATACENTER_ENDPOINT=dc.decodo.com:10001
SMARTPROXY_DATACENTER_PORT_START=10001
SMARTPROXY_DATACENTER_PORT_COUNT=1000
SMARTPROXY_RESIDENTIAL_USERNAME=
SMARTPROXY_RESIDENTIAL_PASSWORD=
SMARTPROXY_RESIDENTIAL_ENDPOINT=isp.decodo.com:10001
SMARTPROXY_RESIDENTIAL_PORT_START=10001
SMARTPROXY_RESIDENTIAL_PORT_COUNT=10

# Profile review requires explicit Save. Currency changes require a new budget.
# Hard filters exclude unknown fields; purpose/date remain advisory.
# Whole KRW and USD/KGS minor units are distinct. Expired NBKR conversion is not a price.
# NBKR effective dates use Bishkek midnight. Prepublished next-day XML is never used early:
# without a valid cached quote, the bounded official archive supplies the current effective rate.
# Total budgets exclude foreign offers until real landed costs can be calculated.
# pnpm autodom import-sqlite SNAPSHOT imports legacy schema1–5 read-only into EMPTY PG.
# Revisions, drafts, preferences, cursors, quiet hours and source metadata survive import.
# Native snapshots write schema 3; schemas 1/2/3 restore without historical ad permission.
# pnpm autodom backup SNAPSHOT.ndjson; restore only into an EMPTY database.
# /delete clears active user state; private snapshots expire within seven days.
# Local snapshots are not off-site protection against server or disk loss.
# Tests: pnpm test (Docker/Testcontainers), or set an isolated AUTODOM_TEST_DATABASE_URL.
