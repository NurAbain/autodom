# Local setup: uv sync --dev; copy this file to .env and fill the secrets.
# Export with: set -a; . ./.env; set +a
# Collect: uv run autodom sync --pages 3
# Start: uv run autodom run
# Docker/Coolify: docker compose up -d --build (one replica only).
# Status: uv run autodom status
# Backup/restore commands and safe-new-directory usage: uv run autodom --help
# This file is not loaded automatically by the Python process.
# Leave token unset to read it from: pass show autodom/telegram/bot-token
AUTODOM_BOT_TOKEN=
AUTODOM_DATA_DIR=.local
AUTODOM_REFRESH_SECONDS=300
AUTODOM_REFRESH_PAGES=3
AUTODOM_CRAWL_DELAY=2
AUTODOM_FULL_REFRESH_SECONDS=86400
AUTODOM_MONITOR_SECONDS=30
AUTODOM_BACKUP_DIR=.local/backups

# Copy Domcom's existing secrets into local/Coolify environment, never into Git.
# Primary: datacenter. Fallback: active residential ISP pool used by Domcom.
# Both routes are required; there is no direct-network fallback.
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
SMARTPROXY_DATACENTER_ENDPOINT=dc.decodo.com:10001
SMARTPROXY_DATACENTER_PORT_START=10001
SMARTPROXY_DATACENTER_PORT_COUNT=1000
SMARTPROXY_RESIDENTIAL_USERNAME=
SMARTPROXY_RESIDENTIAL_PASSWORD=
SMARTPROXY_RESIDENTIAL_ENDPOINT=isp.decodo.com:10001
SMARTPROXY_RESIDENTIAL_PORT_START=10001
SMARTPROXY_RESIDENTIAL_PORT_COUNT=10

# /delete removes active user state immediately. Private local snapshots expire
# within seven days; local snapshots are not protection against losing the server.
