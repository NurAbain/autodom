{
  "name": "autodom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm build:runtime && pnpm build:bot && pnpm build:worker && pnpm build:vin",
    "build:runtime": "tsup --config tsup.config.ts",
    "build:bot": "tsup --config apps/bot/tsup.config.ts",
    "build:worker": "tsup --config apps/worker/tsup.config.ts",
    "build:vin": "tsup --config apps/vin/tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "autodom": "node apps/runtime/dist/cli.js",
    "bot": "node apps/bot/dist/cli.js",
    "worker": "node apps/worker/dist/cli.js",
    "vin": "node apps/vin/dist/cli.js"
  },
  "dependencies": {
    "@crawlee/basic": "3.18.1",
    "@crawlee/core": "3.18.1",
    "@grammyjs/runner": "2.0.3",
    "@prometheus-io/client": "0.16.1",
    "abort-controller": "3.0.0",
    "bullmq": "5.81.4",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "domhandler": "5.0.3",
    "drizzle-orm": "0.45.2",
    "entities": "4.5.0",
    "fast-xml-parser": "5.11.1",
    "grammy": "1.46.0",
    "impit": "0.14.5",
    "ioredis": "5.11.1",
    "p-limit": "7.3.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "tough-cookie": "6.0.2",
    "undici": "7.29.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
